# OSMRoad configuration
#
# There are NO client-side environment variables. Everything the browser needs
# is either build-time (Vite) or served by the Worker.
#
# The AI query backend runs in the Cloudflare Worker. It prefers SumoPod
# (OpenAI-compatible) and falls back to the Workers AI binding. See
# worker/index.ts, worker/nl2sql.ts and the `vars` block in wrangler.jsonc.

# ── Worker variables (wrangler.jsonc → "vars") ───────────────────────────────
AI_BASE_URL=https://ai.sumopod.com/v1
AI_MODEL=gpt-4o-mini
AI_FALLBACK_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct

# Origins allowed to call POST /api/ai/query. Empty disables the check.
# This is a drive-by-abuse brake, not a security boundary.
ALLOWED_ORIGINS=https://osmroad.gislabs.workers.dev,http://localhost:8787,http://localhost:5173

# ── Secrets ─────────────────────────────────────────────────────────────────
# NOT set in this file, and never committed. Production:
#     npx wrangler secret put AI_API_KEY
# Local (`npm run cf-dev`): copy .dev.vars.example to .dev.vars and fill it in.
#
# Leaving AI_API_KEY unset is fully supported: the endpoint uses Workers AI.

# ── Local development ───────────────────────────────────────────────────────
# `npm run dev` runs Vite alone: no Worker, no AI route, no R2. The app falls
# back to its offline NL2SQL parser and to files you drop in yourself.
#
# To exercise the Worker, the R2 samples and the AI route locally:
#   npm run cf-dev          # builds, then `wrangler dev` on http://localhost:8787
