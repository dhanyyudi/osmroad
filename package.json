{
	"name": "osmroad",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "node scripts/prepare-duckdb-wasm.mjs && vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"postinstall": "node patches/fix-vt-relation-exclusion.js",
		"prebuild": "node patches/fix-vt-relation-exclusion.js",
		"cf-typegen": "wrangler types --env-file .dev.vars.example",
		"cf-dev": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"deploy:dry-run": "npm run build && wrangler deploy --dry-run",
		"tail": "wrangler tail",
		"geoparquet": "node scripts/pbf-to-geoparquet.mjs",
		"assets:upload": "node scripts/upload-assets.mjs"
	},
	"dependencies": {
		"@duckdb/duckdb-wasm": "^1.29.0",
		"comlink": "^4.4.2",
		"hyparquet-writer": "^0.16.10",
		"jszip": "^3.10.1",
		"lucide-react": "^0.500.0",
		"maplibre-gl": "^5.5.0",
		"osmix": "^0.2.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-map-gl": "^8.1.0",
		"shapefile": "^0.6.6",
		"togeojson": "^0.16.0",
		"workbox-precaching": "^7.4.0",
		"workbox-window": "^7.4.0",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^25.5.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^4.5.0",
		"tailwindcss": "^4.1.0",
		"typescript": "^5.8.0",
		"vite": "^6.3.0",
		"vite-plugin-pwa": "^1.2.0",
		"wrangler": "^4.142.0"
	}
}
